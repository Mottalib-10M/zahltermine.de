---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'de';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'meine-zahltage', h2: 'Meine nächsten Zahlungen', text: 'Leistungen antippen: Ihre Leser sehen ihre nächsten Zahltage mit Countdown und laden sie als Kalenderdatei herunter.', t: 'Meine nächsten Zahlungen', h: 1000 },
  { name: 'kindergeld', h2: 'Kindergeld nach Endziffer', text: 'Endziffer und Monat wählen: der Auszahlungstag der Familienkasse, die nächsten Monate und alle Endziffern.', t: 'Kindergeld-Auszahlungstermine', h: 900 },
  { name: 'rente', h2: 'Rentenzahltermine', text: 'Rentenbeginn und Monat wählen: der Zahltag, der Grund für jede Verschiebung und das ganze Jahr.', t: 'Rentenzahltermine', h: 900 },
];
---
<PageLayout title="Zahltermin-Kalender kostenlos einbinden: Kindergeld, Rente" description="Kindergeld-Termine, Rentenzahltermine und den persönlichen Zahltermin-Kalender kostenlos per iframe einbinden: Code kopieren, neue Termine erscheinen von selbst." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Start', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Zahltermin-Kalender einbinden</h1>
    <p class="mt-3 text-lg text-navy-700">Für Beratungsstellen, Vereine, Seniorenbüros und Lokalzeitungen: einmal kopieren, neue Termine erscheinen von selbst.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>Für die englische Fassung ersetzen Sie <code>/embed/de/</code> durch <code>/embed/en/</code>. Bedingungen: Der Quellenlink unter dem Rechner bleibt sichtbar, der Rechner wird nicht verändert und ohne Gewähr bereitgestellt. Was Ihre Leser eingeben, bleibt auf deren Gerät. Fragen über die <a href={route('contact', lang)}>Kontaktseite</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/meine-zahltage/`} title="Meine nächsten Zahlungen" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
